KStock patch 22。

上游 AGENT_PRESET_GLOB 只覆盖引擎树内的 shipped 预设
（packages/preset/agent-presets/presets/*/agent.cordis.yml）；产品态预设位于
产品仓（../../kstock/presets/*/agent.cordis.yml，随包分发的真正预设面），
glob 覆盖不到 → 本门禁对产品预设空转假绿。

修法：glob 改为 brace 展开，两个目录一并纳入。相对深度 2 与引擎在产品仓内的
落点无关（vendor/qilin、engine/qilin 等布局均成立）。
---
 scripts/verify-runtime-closure.ts | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/scripts/verify-runtime-closure.ts b/scripts/verify-runtime-closure.ts
index 5e2ec31d55..22dbae6a35 100644
--- a/scripts/verify-runtime-closure.ts
+++ b/scripts/verify-runtime-closure.ts
@@ -33,7 +33,10 @@ interface RuntimePlatform {
 
 type RuntimePlatformManifest = Record<string, RuntimePlatform>
 
-const AGENT_PRESET_GLOB = 'packages/preset/agent-presets/presets/*/agent.cordis.yml'
+// KStock patch: preset glob 扩展——上游 glob 只覆盖引擎 shipped 预设，
+// KStock 产品态预设（kstock/presets，随包分发的真正预设面）在引擎树
+// 之外，纳入后才受本门禁保护，否则对产品预设空转假绿。
+const AGENT_PRESET_GLOB = '{packages/preset/agent-presets/presets/*/agent.cordis.yml,../../kstock/presets/*/agent.cordis.yml}'
 
 export interface RuntimeClosureResult {
   failures: string[]


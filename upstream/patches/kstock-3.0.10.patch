-  height: 52px;
+  height: 48px;
   box-sizing: border-box;
   margin: -6px calc(-1 * var(--qilin-sidebar-inline-padding)) 0;
   padding: 0 12px;
@@ -194,9 +194,11 @@
 /* The strip's full 52px foot leaves the wordmark too low; the content column

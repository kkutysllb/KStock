# QiLin 引擎相对 CWD 默认落点 —— 正式运行时数据应走系统 app data 目录
# （见 scripts/run_gateway.py 与 docs/用户数据空间组织设计.md），这里作为防御。
.qilin/
.kstock/
sidecar/build/
sidecar/dist/
sidecar/*.egg-info/
*.egg-info/
*.log
# 开发日志目录（覆写模式，不入库）—— *.log 已有规则，此处补目录级防御
logs/
# uv 锁文件提交以保证可复现，但 uv 本地缓存不入库
# （uv.lock 应提交，此处不忽略它）
results/
.release-logs/
# 技能包 vendored Python 构建产物（bdist/lib），不入库
vendor/**/build/

# QiLin 3.x monorepo 快照（vendor/qilin）的本地构建产物——同步脚本拷入的是纯源码，
# 以下均为 vendor 内执行 pnpm install/build 后生成的产物，不入库
vendor/qilin/**/lib/
dist-exe/
vendor/qilin/dist-exe/
vendor/qilin/**/.turbo/
vendor/qilin/**/tsconfig*.tsbuildinfo
vendor/qilin/**/vitest.*.tsbuildinfo

# WorkBuddy 本地工作数据（记忆/日志），不入库
.workbuddy/
tests/.test_release_packaging.py.swp

# Windows ���������ع���������ʱ���uv ��װĿ¼ / ��ʱ��֤��ͼ��
.tools/
.tmp/

# dsh（DeepSeek Harness）临时落盘：用户上传的附件 / 截图、会话 drop。
# 这些是用户与 agent 交互的一次性数据，不应入库。
.drops/

# pnpm 自建内容可寻址 store（pnpm install 时自动生成），不入库
.pnpm-store/
# preset 随行技能目录：patch_vendor_skills.py 从 vendor/skills/public 幂等发布的
# 生成物（构建脚本已串联补丁器自动重建），不入库
kstock/presets/*/skills/

# 浏览器验证（Playwright MCP）产物
.playwright-mcp/

# 本地工具目录
.zcode/


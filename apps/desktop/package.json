{
  "name": "kstock-desktop",
  "private": true,
  "version": "2.0.0",
  "description": "KStock — A股量化分析 Super Agent 桌面端",
  "homepage": "https://github.com/kkutysllb/KStock",
  "license": "MIT",
  "author": {
    "name": "kkutysllb",
    "email": "13609247807@139.com",
    "url": "https://github.com/kkutysllb"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:electron-main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outdir=dist-electron --out-extension:.js=.cjs --external:electron --external:electron-updater",
    "electron:dev": "pnpm build:electron-main && node scripts/run.mjs electron .",
    "electron:build": "pnpm build:electron-main && node scripts/run.mjs electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "@types/node": "^22.7.4",
    "typescript": "^5.5.4"
  }
}

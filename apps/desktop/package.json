{
  "name": "@kstock/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "KStock — A股量化分析 Super Agent 桌面端",
  "homepage": "https://github.com/kkutysllb/KStock",
  "license": "MIT",
  "author": {
    "name": "kkutysllb",
    "email": "13609247807@139.com",
    "url": "https://github.com/kkutysllb"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron-main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --outdir=dist-electron --out-extension:.js=.cjs --external:electron --external:electron-updater",
    "electron:dev": "pnpm build:electron-main && concurrently -k -n VITE,ELECTRON \"vite\" \"wait-on tcp:1420 && cross-env VITE_DEV_SERVER_URL=http://localhost:1420 electron .\"",
    "electron:build": "pnpm build:electron-main && cross-env VITE_GATEWAY_URL=app://localhost/gateway vite build && electron-builder --publish never",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.539.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "wait-on": "^8.0.1"
  }
}
